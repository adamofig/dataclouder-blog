/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 1rem
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: oklch(0.35 0.16 308) oklch(0.88 0.17 165)
  --page-bg: oklch(0.96 0.012 300) oklch(0.12 0.025 305)
  --card-bg: white oklch(0.17 0.03 305)

  --btn-content: oklch(0.35 0.16 308) oklch(0.88 0.17 165)

  --btn-regular-bg: oklch(0.94 0.025 300) oklch(0.24 0.04 305)
  --btn-regular-bg-hover: oklch(0.90 0.045 300) oklch(0.29 0.05 305)
  --btn-regular-bg-active: oklch(0.85 0.07 300) oklch(0.34 0.06 305)

  --btn-plain-bg-hover: oklch(0.94 0.025 300) oklch(0.24 0.04 305)
  --btn-plain-bg-active: oklch(0.96 0.015 300) oklch(0.20 0.03 305)

  --btn-card-bg-hover: oklch(0.97 0.01 300) oklch(0.22 0.035 305)
  --btn-card-bg-active: oklch(0.92 0.03 300) oklch(0.27 0.045 305)

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.25 0.04 308) oklch(0.92 0.03 165)

  --title-active: oklch(0.40 0.16 308) oklch(0.88 0.17 165)

  --line-divider: black(0.08) white(0.08)

  --line-color: black(0.1) white(0.12)
  --meta-divider: black(0.2) white(0.25)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.90 0.06 308) oklch(0.35 0.10 165)
  --codeblock-selection: oklch(0.35 0.10 165)
  --codeblock-bg: oklch(0.14 0.03 305) oklch(0.11 0.025 305)
  --codeblock-topbar-bg: oklch(0.22 0.035 305) oklch(0.14 0.03 305)

  --license-block-bg: black(0.03) var(--codeblock-bg)

  --link-underline: oklch(0.85 0.08 308) oklch(0.60 0.14 165)
  --link-hover: oklch(0.45 0.16 308) oklch(0.88 0.17 165)
  --link-active: oklch(0.35 0.16 308) oklch(0.78 0.18 165)

  --float-panel-bg: white oklch(0.16 0.03 305)

  --scrollbar-bg-light: black(0.3)
  --scrollbar-bg-hover-light: black(0.45)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.3)
  --scrollbar-bg-hover-dark: white(0.45)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.75 0.17 165) oklch(0.80 0.18 165)
  --admonitions-color-note: oklch(0.55 0.14 245) oklch(0.65 0.16 245)
  --admonitions-color-important: oklch(0.45 0.16 308) oklch(0.75 0.18 308)
  --admonitions-color-warning: oklch(0.7 0.14 60) oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25) oklch(0.65 0.2 25)

  --toc-badge-bg: oklch(0.92 0.04 308) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.93 0.02 308) oklch(0.22 0.035 305)
  --toc-btn-active: oklch(0.90 0.03 308) oklch(0.26 0.045 305)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.35 0.16 308) oklch(0.88 0.17 165)
})
